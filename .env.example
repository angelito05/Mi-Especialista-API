# Variables de entorno para producción en la nube (Render, Railway, etc.)
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Clave secreta para tokens JWT (En tu host genera una cadena larga y aleatoria)
SECRET_KEY=cambiar_por_una_clave_secreta_en_produccion

# URL de conexión a PostgreSQL (Aiven Cloud u otro proveedor)
DATABASE_URL=postgresql://usuario:password@host:puerto/defaultdb?sslmode=require

# Tiempo de vida de los tokens JWT en horas
JWT_EXPIRATION_HOURS=24
